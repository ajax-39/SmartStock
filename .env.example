# SmartStock Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git!

# Dataset Path Configuration
# Option 1: Point directly to Kagglehub cache (recommended, avoids duplicating ~1GB data)
# SMARTSTOCK_DATASET_PATH=C:\Users\Asus\.cache\kagglehub\datasets\debashis74017\stock-market-data-nifty-50-stocks-1-min-data\versions\1
# Option 2: Point to a local directory or custom path
# SMARTSTOCK_DATASET_PATH=data/raw
# Option 3: Future Google Cloud Storage path
# SMARTSTOCK_DATASET_PATH=gs://your-bucket-name/raw

# Local Storage Directory Overrides (optional)
# SMARTSTOCK_RAW_DATA_PATH=data/raw
# SMARTSTOCK_PROCESSED_DATA_PATH=data/processed
# SMARTSTOCK_CACHE_PATH=data/cache

# Kaggle API Credentials (optional for public datasets, required for private ones)
# Get from: https://www.kaggle.com/account
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key
# KAGGLE_DATASET_ID=debashis74017/stock-market-data-nifty-50-stocks-1-min-data

# Data Ingestion & Processing Settings
# INGESTION_CHUNK_SIZE=100000
# INGESTION_PARTITION_BY_SYMBOL=true
# MIN_DATA_POINTS=10000

# Spark Configuration (local and cluster)
# SPARK_MASTER=local[*]
# SPARK_APP_NAME=SmartStock
# SPARK_EXECUTOR_MEMORY=4g
# SPARK_DRIVER_MEMORY=2g
# SPARK_LOG_LEVEL=WARN

# Google Cloud Platform (Phase 7 - Deployment)
# GCP_PROJECT_ID=your-gcp-project
# GCP_REGION=us-central1
# GCP_BUCKET_NAME=your-bucket-name
# GCS_RAW_DATA_PATH=gs://your-bucket-name/raw
# GCS_PROCESSED_DATA_PATH=gs://your-bucket-name/processed
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# DATAPROC_CLUSTER=smartstock-cluster

# Application Settings
# DEBUG=False
# LOG_LEVEL=INFO
